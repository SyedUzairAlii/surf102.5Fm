{
  "expo": {
    "name": "Surf 102.5 FM",
    "slug": "surf-1025-fm",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon-image.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.syeduzairali.surf1025"
    },
    "android": {
      "package": "com.syeduzairali.surf1025",
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon-image.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/app-icon-image.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/app-icon-image.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      "expo-audio",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
